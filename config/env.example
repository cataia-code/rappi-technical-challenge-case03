# === Rappi Caso 03 — plantilla de entorno ===
# Copiar a .env y completar con al menos UNA API key de proveedor LLM.
# El pipeline usa los proveedores en el orden de LLM_PROVIDER_ORDER y hace
# fallback al siguiente si uno agota su cuota. El modo --no-llm no consume tokens.

# --- Proveedores LLM (OpenAI-compatible) — completar al menos uno ---
GROQ_API_KEY=gsk_tu_clave_aqui
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Orden de fallback entre proveedores (solo se usan los que tengan API key)
LLM_PROVIDER_ORDER=groq,gemini,openrouter

# --- Parámetros del motor de decisión ---
LLM_TEMPERATURE=0
CONFIDENCE_ESCALATE_THRESHOLD=0.6

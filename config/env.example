# === Rappi Case 03 environment template ===
# Copy this file to .env and fill at least one LLM provider API key.
# The pipeline uses LLM_PROVIDER_ORDER as fallback order. Providers without keys
# are skipped. The --no-llm mode does not consume tokens.

# --- LLM providers (OpenAI-compatible) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Fallback order. Only providers with configured API keys are used.
LLM_PROVIDER_ORDER=groq,gemini,openrouter

# --- Decision-engine parameters ---
LLM_TEMPERATURE=0
CONFIDENCE_ESCALATE_THRESHOLD=0.6
